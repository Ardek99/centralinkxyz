<style>
    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-group label {
        display: block;
        margin-bottom: 0.5rem;
        font-weight: 500;
        color: var(--color-text);
    }

    .form-input,
    .form-select {
        width: 100%;
        padding: 0.875rem 1rem;
        background: var(--color-bg);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        color: var(--color-text);
        font-family: var(--font-sans);
        font-size: 1rem;
        transition: all var(--transition);
    }

    .form-input:focus,
    .form-select:focus {
        outline: none;
        border-color: var(--color-accent);
        box-shadow: 0 0 0 3px var(--color-accent-glow);
    }

    .form-input::placeholder {
        color: var(--color-text-muted);
    }

    .form-select option {
        background: var(--color-bg-secondary);
        color: var(--color-text);
    }

    .form-hint {
        font-size: 0.85rem;
        color: var(--color-text-muted);
        margin-top: 0.5rem;
    }

    .form-error {
        color: #ef4444;
        font-size: 0.85rem;
        margin-top: 0.5rem;
    }

    .form-actions {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
    }
</style>

{% set hasBlockchainLookup = false %}
{% for field in form %}
    {% if field.vars.name != '_token' %}
        <div class="form-group">
            {{ form_label(field) }}
            {{ form_widget(field) }}
            {% if field.vars.errors|length > 0 %}
                <div class="form-error">{{ form_errors(field) }}</div>
            {% endif %}
        </div>

        {% if field.vars.name == 'blockchainTxHash' %}
            {% set hasBlockchainLookup = true %}
            <button type="button" id="btn-lookup-blockchain" class="btn btn-secondary">
                🔍 Récupérer depuis la blockchain
            </button>
        {% endif %}
    {% endif %}
{% endfor %}

{{ form_rest(form) }}

{% if hasBlockchainLookup %}
    <script>
        document.getElementById('btn-lookup-blockchain').addEventListener('click', async () => {
            const hash = document.getElementById('transaction_blockchainTxHash').value.trim();

            if (!hash) {
                alert('Merci de renseigner un hash de transaction.');
                return;
            }

            try {
                const response = await fetch(`/transactions/lookup-blockchain?hash=${encodeURIComponent(hash)}`);
                const data = await response.json();

                if (!response.ok) {
                    alert(data.error ?? 'Erreur inconnue');
                    return;
                }

                // Remplir le montant investi (data.amount est en BTC, data.price en $/BTC)
                document.getElementById('transaction_usdAmount').value = (data.amount * data.price).toFixed(2);

                document.getElementById('transaction_entryPrice').value = data.price.toFixed(8);

                // Remplir la date — format attendu par <input type="datetime-local"> : "YYYY-MM-DDTHH:mm"
                const date = new Date(data.date);
                const isoLocal = date.toISOString().slice(0, 16);
                document.getElementById('transaction_transactionDate').value = isoLocal;

            } catch (e) {
                alert('Impossible de contacter le service blockchain.');
            }
        });
    </script>
{% endif %}




